# JARVIS Brain Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# LLM API Keys (Add at least one)
# ============================================

# Google Gemini (Flash 2.5)
# Get key: https://makersuite.google.com/app/apikey
JARVIS_GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Llama 3.1 8B)
# Get key: https://console.groq.com/keys
JARVIS_GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Auto model selection)
# Get key: https://openrouter.ai/keys
JARVIS_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cerebras (Llama 3.1 8B)
# Get key: https://inference.cerebras.ai/
JARVIS_CEREBRAS_API_KEY=your_cerebras_api_key_here

# Mistral (Mistral Small)
# Get key: https://console.mistral.ai/
JARVIS_MISTRAL_API_KEY=your_mistral_api_key_here

# Together AI (Llama 3.1 8B)
# Get key: https://api.together.xyz/
JARVIS_TOGETHER_API_KEY=your_together_api_key_here

# Cohere (Command R)
# Get key: https://dashboard.cohere.ai/
JARVIS_COHERE_API_KEY=your_cohere_api_key_here

# DeepSeek (DeepSeek Chat)
# Get key: https://platform.deepseek.com/
JARVIS_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================
# Brain Server Configuration
# ============================================

# WebSocket server binding address
# 0.0.0.0 = All interfaces (use for physical devices on same Wi-Fi)
# 127.0.0.1 = Localhost only (use for emulator or on-device brain)
JARVIS_BIND=0.0.0.0

# WebSocket server port
JARVIS_PORT=9741

# ============================================
# Optional: Free Tool API Keys
# ============================================

# NewsAPI.org (optional - news tool)
# Get key: https://newsapi.org/
# JARVIS_NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# Notes
# ============================================

# 1. You only need to add API keys for the providers you want to use
# 2. The brain will automatically failover between available keys
# 3. For development, start with one free provider (Groq or DeepSeek are good choices)
# 4. Never commit .env file to version control
# 5. Keep your API keys secure and don't share them