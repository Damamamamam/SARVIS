<Window x:Class="JarvisWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SARVIS Windows Assistant" Height="650" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SARVIS" FontSize="24" FontWeight="Bold" Foreground="#00ffcc"/>
                    <TextBlock Text="  Windows Assistant" FontSize="15" VerticalAlignment="Center" Foreground="#888"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Connection Indicator -->
                    <Ellipse Width="10" Height="10" Fill="#ff4444" Margin="0,0,6,0" x:Name="ConnectionIndicator"/>
                    <TextBlock Text="Disconnected" VerticalAlignment="Center" Foreground="#aaa" Margin="0,0,15,0" x:Name="ConnectionStatus"/>

                    <!-- Action Buttons -->
                    <Button x:Name="ReconnectButton" Content="Reconnect" Width="85" Height="30" Margin="0,0,8,0"
                            Background="#383838" Foreground="White" BorderBrush="#555" Click="ReconnectButton_Click"/>

                    <Button x:Name="SettingsButton" Content="⚙ Settings" Width="85" Height="30"
                            Background="#383838" Foreground="#00ffcc" BorderBrush="#555" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notification Banner -->
        <Border Grid.Row="1" x:Name="NotificationBanner" Background="#332b00" BorderBrush="#ffbb00" BorderThickness="0,0,0,1" Padding="10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NotificationText" Text="Notification message" Foreground="#ffdd55" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="✕" Width="26" Height="26" Background="Transparent" Foreground="#ffdd55" BorderThickness="0" Click="DismissNotification_Click"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="15,10,15,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat/Log Area -->
            <Border Grid.Row="0" Background="#252525" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="5">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Text="SARVIS is ready..." Padding="12" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                </ScrollViewer>
            </Border>

            <!-- Audio Visualization Bar -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mic Level:" Foreground="#777" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ProgressBar Grid.Column="1" x:Name="AudioLevelBar" Height="4" Minimum="0" Maximum="100" Value="0"
                             Foreground="#00ffcc" Background="#2d2d2d" BorderThickness="0"/>
            </Grid>

            <!-- Audio Waveform Visualization -->
            <Grid Grid.Row="1" Margin="0,16,0,0" Height="40">
                <Border Background="#1a1a1a" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="3">
                    <Canvas x:Name="WaveformCanvas" ClipToBounds="True"/>
                </Border>
            </Grid>

            <!-- Input Area -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="InputTextBox" 
                         Height="42" Padding="10" FontSize="14"
                         Background="#2d2d2d" Foreground="White" BorderBrush="#3d3d3d"
                         KeyDown="InputTextBox_KeyDown"/>
                
                <Button Grid.Column="1" Content="Send" Width="90" Height="42" Margin="10,0,0,0"
                        Background="#00ffcc" Foreground="#1e1e1e" FontWeight="Bold"
                        BorderThickness="0" Click="SendButton_Click"/>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#2d2d2d" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Active App Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Active App: " Foreground="#888"/>
                    <TextBlock Text="None" Foreground="#ddd" x:Name="ActiveAppStatus"/>
                </StackPanel>
                
                <!-- Audio Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Audio: " Foreground="#888"/>
                    <TextBlock Text="Inactive" Foreground="#ff4444" x:Name="AudioStatus"/>
                </StackPanel>
                
                <!-- TTS Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="TTS: " Foreground="#888"/>
                    <TextBlock Text="Ready" Foreground="#00ff88" x:Name="TTSStatus"/>
                </StackPanel>
                
                <!-- Speech Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Speech STT: " Foreground="#888"/>
                    <TextBlock Text="Listening" Foreground="#00ccff" x:Name="SpeechStatus"/>
                </StackPanel>

                <!-- Vision Camera Status -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Vision: " Foreground="#888"/>
                    <TextBlock Text="Active" Foreground="#00ffcc" x:Name="VisionStatus"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>