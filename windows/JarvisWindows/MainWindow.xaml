<Window x:Class="JarvisWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SARVIS Windows Assistant" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="SARVIS" FontSize="24" FontWeight="Bold" Foreground="#00ffcc"/>
                    <TextBlock Text="  Windows Assistant" FontSize="16" VerticalAlignment="Center" Foreground="#888"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#ff4444" Margin="0,0,5,0" x:Name="ConnectionIndicator"/>
                    <TextBlock Text="Disconnected" VerticalAlignment="Center" Foreground="#888" x:Name="ConnectionStatus"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat/Log Area -->
            <Border Grid.Row="0" Background="#252525" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="5">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Text="SARVIS is ready..." Padding="10" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                </ScrollViewer>
            </Border>

            <!-- Input Area -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="InputTextBox" 
                         Height="40" Padding="10" FontSize="14"
                         Background="#2d2d2d" Foreground="White" BorderBrush="#3d3d3d"
                         KeyDown="InputTextBox_KeyDown"/>
                
                <Button Grid.Column="1" Content="Send" Width="80" Height="40" Margin="10,0,0,0"
                        Background="#00ffcc" Foreground="#1e1e1e" FontWeight="Bold"
                        BorderThickness="0" Click="SendButton_Click"/>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#2d2d2d" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Audio: " Foreground="#888"/>
                    <TextBlock Text="Inactive" Foreground="#ff4444" x:Name="AudioStatus"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="TTS: " Foreground="#888"/>
                    <TextBlock Text="Ready" Foreground="#00ff88" x:Name="TTSStatus"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="Speech: " Foreground="#888"/>
                    <TextBlock Text="Listening" Foreground="#00ccff" x:Name="SpeechStatus"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>